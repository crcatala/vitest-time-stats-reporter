{
  "name": "vitest-time-stats-reporter",
  "version": "0.4.0",
  "description": "An additive Vitest reporter that shows test execution-time distribution — histogram, percentiles, and slow-test concentration",
  "keywords": [
    "vitest",
    "reporter",
    "test",
    "timing",
    "histogram",
    "performance"
  ],
  "license": "MIT",
  "author": "Chris Catala",
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crcatala/vitest-time-stats-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/crcatala/vitest-time-stats-reporter/issues"
  },
  "homepage": "https://github.com/crcatala/vitest-time-stats-reporter#readme",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/reporter.js",
      "types": "./dist/reporter.d.ts"
    },
    "./timing-stats": {
      "import": "./dist/timing-stats.js",
      "types": "./dist/timing-stats.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vitest run --config vitest.demo.config.ts",
    "demo:json": "vitest run --config vitest.demo-json.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test:package": "node scripts/check-package.mjs",
    "format": "biome format --write",
    "format:check": "biome format",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run demo && npm run demo:json",
    "prepublishOnly": "npm run verify && npm run build && npm run test:package",
    "release": "release-it",
    "release:dry": "release-it --dry-run --no-npm --no-github",
    "release:prep": "bash scripts/prep-release.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@release-it/keep-a-changelog": "^7.0.0",
    "@types/node": "^24.0.0",
    "release-it": "^20.2.1",
    "typescript": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
